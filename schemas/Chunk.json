{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chunk",
  "type": "object",
  "required": ["id", "unit_ids", "text", "token_count"],
  "properties": {
    "id":          { "type": "string", "description": "SHA-256 of the chunk text" },
    "unit_ids":    { "type": "array", "items": { "type": "string" } },
    "text":        { "type": "string" },
    "token_count": { "type": "integer", "minimum": 0 },
    "strategy":    { "type": "string", "enum": ["hierarchical", "sliding", "semantic"] },
    "embedding":   { "type": "array", "items": { "type": "number" } }
  }
}
