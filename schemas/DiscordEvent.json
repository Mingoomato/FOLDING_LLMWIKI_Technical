{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmwiki.dev/schemas/DiscordEvent.json",
  "title": "DiscordEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_key",
    "event_type",
    "channel_id",
    "occurred_at",
    "received_at",
    "payload"
  ],
  "properties": {
    "event_key": {
      "type": "string",
      "minLength": 1,
      "description": "Stable idempotency key for a historical item or Gateway dispatch."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "MESSAGE_CREATE",
        "MESSAGE_UPDATE",
        "MESSAGE_DELETE",
        "THREAD_CREATE",
        "THREAD_UPDATE",
        "THREAD_DELETE"
      ]
    },
    "guild_id": {
      "type": ["string", "null"]
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": ["string", "null"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "Original Discord payload plus namespaced adapter metadata.",
      "additionalProperties": true
    }
  }
}
